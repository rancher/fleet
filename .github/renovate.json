{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>rancher/renovate-config//rancher-main#main"
  ],
  "baseBranchPatterns": [
    "main",
    "release/v0.16",
    "release/v0.15",
    "release/v0.14",
    "release/v0.13",
    "release/v0.12"
  ],
  "prHourlyLimit": 6,
  "ignorePaths": [
    "**/assets/**"
  ],
  "packageRules": [
    {
      "matchBaseBranches": [
        "release/v0.16"
      ],
      "extends": [
        "github>rancher/renovate-config//rancher-2.15#main"
      ]
    },
    {
      "matchBaseBranches": [
        "release/v0.15"
      ],
      "extends": [
        "github>rancher/renovate-config//rancher-2.14#main"
      ]
    },
    {
      "matchBaseBranches": [
        "release/v0.14"
      ],
      "extends": [
        "github>rancher/renovate-config//rancher-2.13#main"
      ]
    },
    {
      "matchBaseBranches": [
        "release/v0.13"
      ],
      "extends": [
        "github>rancher/renovate-config//rancher-2.12#main"
      ]
    },
    {
      "matchBaseBranches": [
        "release/v0.12"
      ],
      "extends": [
        "github>rancher/renovate-config//rancher-2.11#main"
      ]
    },
    {
      "description": "Activate automerge for eligible updates",
      "matchBaseBranches": [
        "main",
        "release/v0.16",
        "release/v0.15",
        "release/v0.14",
        "release/v0.13",
        "release/v0.12"
      ],
      "extends": [
        "github>rancher/renovate-config//automerge#main"
      ]
    },
    {
      "description": "Update Wrangler in Helm values module",
      "matchManagers": ["gomod"],
      "matchFileNames": ["pkg/helmvalues/go.mod"],
      "matchPackageNames": ["github.com/rancher/wrangler/v3"],
      "enabled": true,
      "groupName": "wrangler-lasso",
      "minimumGroupSize": 1
    },
    {
      "description": "Wait for paired Kubernetes updates in Helm values module",
      "matchManagers": ["gomod"],
      "matchFileNames": ["pkg/helmvalues/go.mod"],
      "matchPackageNames": [
        "k8s.io/api",
        "k8s.io/apimachinery"
      ],
      "enabled": true,
      "groupName": "Kubernetes dependencies",
      "minimumGroupSize": 2
    }
  ]
}
